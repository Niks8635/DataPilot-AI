# ==============================================================================
# DataPilot AI — Environment Configuration Example
# ==============================================================================

# Backend Configuration
PROJECT_NAME="DataPilot AI"
SECRET_KEY=datapilot-production-secure-random-key-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database: SQLite for zero-config local run, or PostgreSQL / Supabase for production
DATABASE_URL=sqlite:///./datapilot.db
# DATABASE_URL=postgresql://user:password@localhost:5432/datapilot_db
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Auth & Storage (Optional)
SUPABASE_URL=https://[YOUR_PROJECT_ID].supabase.co
SUPABASE_KEY=your-anon-or-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# AI Providers: "auto", "gemini", "openai", "anthropic"
AI_PROVIDER=auto
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Execution Sandbox Limits
MAX_UPLOAD_SIZE_MB=100
SANDBOX_TIMEOUT_SECONDS=5

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
